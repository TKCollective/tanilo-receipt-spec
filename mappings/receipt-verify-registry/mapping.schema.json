{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TKCollective/tanilo-receipt-spec/mappings/receipt-verify-registry/mapping.schema.json",
  "title": "Vector -> requirement mapping (receipt-verify methodology \u00a72.7)",
  "type": "object",
  "required": [
    "mapping_kind",
    "methodology",
    "corpus_snapshot",
    "coverage_rule",
    "cited_texts",
    "requirement_documents",
    "external_documents",
    "corpora",
    "reverse_view",
    "totals",
    "normative_audit"
  ],
  "properties": {
    "mapping_kind": {
      "const": "vector-requirement-mapping"
    },
    "methodology": {
      "type": "object",
      "required": [
        "name",
        "axis",
        "version",
        "url"
      ]
    },
    "corpus_snapshot": {
      "type": "object",
      "required": [
        "repository",
        "commit"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "coverage_rule": {
      "type": "string"
    },
    "requirement_documents": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "title",
          "scope",
          "requirements"
        ],
        "properties": {
          "requirements": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    },
    "external_documents": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "title",
          "pinned",
          "note"
        ]
      }
    },
    "corpora": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "manifest",
          "manifest_sha256",
          "normative",
          "requirement_documents",
          "external_documents",
          "checkers",
          "vectors",
          "vector_count"
        ],
        "properties": {
          "manifest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "vector_count": {
            "type": "integer",
            "minimum": 1
          },
          "vectors": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "requirements": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "requirement",
                      "coverage",
                      "checker",
                      "assertion"
                    ],
                    "properties": {
                      "coverage": {
                        "enum": [
                          "covered",
                          "partial",
                          "not covered"
                        ]
                      }
                    }
                  }
                },
                "external_requirements": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "requirement",
                      "assertion"
                    ]
                  }
                },
                "status": {
                  "enum": [
                    "deferred"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "anyOf": [
                {
                  "required": [
                    "requirements"
                  ],
                  "properties": {
                    "requirements": {
                      "type": "array",
                      "minItems": 1
                    }
                  }
                },
                {
                  "required": [
                    "status",
                    "reason"
                  ],
                  "properties": {
                    "status": {
                      "const": "deferred"
                    },
                    "requirements": {
                      "type": "array",
                      "maxItems": 0
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "reverse_view": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "summary",
          "requirements"
        ],
        "properties": {
          "requirements": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "text",
                "coverage",
                "vectors"
              ],
              "properties": {
                "coverage": {
                  "enum": [
                    "covered",
                    "partial",
                    "not covered"
                  ]
                },
                "coverage_excluding_not_normative": {
                  "enum": [
                    "covered",
                    "partial",
                    "not covered"
                  ]
                },
                "note": {
                  "type": "string"
                }
              }
            }
          },
          "summary_excluding_not_normative": {
            "type": "object",
            "required": [
              "corpora",
              "requirements",
              "covered",
              "partial",
              "not_covered",
              "not_covered_list"
            ],
            "properties": {
              "corpora": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "if": {
          "required": [
            "summary_excluding_not_normative"
          ]
        },
        "then": {
          "properties": {
            "requirements": {
              "additionalProperties": {
                "required": [
                  "text",
                  "coverage",
                  "coverage_excluding_not_normative",
                  "vectors"
                ]
              }
            }
          }
        },
        "else": {
          "properties": {
            "requirements": {
              "additionalProperties": {
                "not": {
                  "required": [
                    "coverage_excluding_not_normative"
                  ]
                }
              }
            }
          }
        }
      },
      "properties": {
        "D01": {
          "required": [
            "summary",
            "summary_excluding_not_normative",
            "requirements"
          ]
        },
        "MAP": {
          "required": [
            "summary",
            "summary_excluding_not_normative",
            "requirements"
          ]
        }
      },
      "$comment": "A view whose scope includes a NOT NORMATIVE corpus must publish summary_excluding_not_normative and coverage_excluding_not_normative on every row. The schema requires it by name for D01 and MAP (the views that include rule2); validate_mapping.py enforces the general rule from each corpus's normative flag."
    },
    "totals": {
      "type": "object",
      "required": [
        "friday_priority",
        "also_accounted",
        "mapped_or_deferred",
        "deferred"
      ]
    },
    "cited_texts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "path",
          "url",
          "sha256"
        ],
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "normative_audit": {
      "type": "object",
      "required": [
        "document",
        "source",
        "sections",
        "keywords",
        "rule",
        "summary",
        "summary_excluding_not_normative",
        "sentences",
        "structural_sources",
        "rows_without_audit_sentence",
        "outside_audit"
      ],
      "properties": {
        "summary": {
          "type": "object",
          "required": [
            "sentences",
            "exercised",
            "unexercised"
          ]
        },
        "sentences": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "n",
              "section",
              "text",
              "requirements",
              "exercised",
              "exercised_excluding_not_normative"
            ],
            "properties": {
              "requirements": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "exercised": {
                "type": "boolean"
              },
              "exercised_excluding_not_normative": {
                "type": "boolean"
              }
            }
          }
        },
        "summary_excluding_not_normative": {
          "type": "object",
          "required": [
            "corpora",
            "sentences",
            "exercised",
            "unexercised",
            "exercised_only_through_not_normative"
          ]
        },
        "structural_sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "n",
              "kind",
              "section",
              "locator",
              "text",
              "requirement"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "list_item",
                  "numbered_step",
                  "table_row"
                ]
              },
              "requirement": {
                "type": "string"
              }
            }
          }
        },
        "rows_without_audit_sentence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outside_audit": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "n",
              "section",
              "text",
              "keyword"
            ],
            "properties": {
              "keyword": {
                "enum": [
                  "MAY",
                  "OPTIONAL"
                ]
              }
            }
          }
        },
        "keywords": {
          "const": [
            "MUST",
            "MUST NOT",
            "SHALL",
            "SHALL NOT",
            "SHOULD",
            "SHOULD NOT",
            "REQUIRED",
            "RECOMMENDED"
          ]
        }
      }
    }
  }
}
